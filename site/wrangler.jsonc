{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sanqiu-tingji-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-03-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/notices.json",
      "/releases/*",
      "/download/*",
      "/models/*"
    ]
  },
  "routes": [
    {
      "pattern": "tingji.liwu.dpdns.org",
      "custom_domain": true
    }
  ]
}
