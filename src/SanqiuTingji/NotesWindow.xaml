<Window x:Class="SanqiuTingji.App.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SanqiuTingji.App"
        Foreground="#141824" FontFamily="Microsoft YaHei UI, Segoe UI"
        Title="{local:Loc Key='实时面板'}" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="CanResizeWithGrip"
        Width="416" Height="640" MinWidth="330" MinHeight="340">
    <Window.Resources>
        <Style TargetType="ResizeGrip">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ResizeGrip">
                        <Grid Width="14" Height="14" Background="Transparent" Margin="0,0,4,4">
                            <Ellipse Width="2.5" Height="2.5" Fill="#8A93A6" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            <Ellipse Width="2.5" Height="2.5" Fill="#8A93A6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,0"/>
                            <Ellipse Width="2.5" Height="2.5" Fill="#8A93A6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Scheme A: Light Apple Liquid Glass Floating Panel (unified with MainWindow) -->
    <Border x:Name="PanelShell" CornerRadius="22" BorderBrush="{StaticResource GlassRim}" BorderThickness="1.2" Margin="10">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
                <GradientStop Color="#EDF9FCFF" Offset="0"/>
                <GradientStop Color="#E2EEF5FF" Offset="0.55"/>
                <GradientStop Color="#DDEAF2FE" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.18" Color="#0C1C3D"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header: drag to move -->
            <Grid x:Name="Header" Grid.Row="0" Background="Transparent" Margin="16,14,14,10" Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="HeaderLeft" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                    <Border x:Name="OnAirPill" Background="#1AEF4444" BorderBrush="#28EF4444" BorderThickness="1" CornerRadius="99" Padding="9,3">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="#EF4444" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="StateText" Text="{local:Loc Key='收听中'}" Foreground="#DC2626" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ClockText" Text="00:00" Foreground="{StaticResource Muted}" FontSize="12.5" FontWeight="SemiBold"
                               FontFamily="Consolas, Microsoft YaHei UI" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Border x:Name="Shared" Background="#1416284C" CornerRadius="99" Padding="7,2" Margin="8,0,0,0" Visibility="Collapsed"
                            ToolTip="{local:Loc Key='截图、录屏和屏幕共享里看不到这个窗口（设置 › 收听与识别里可以改）'}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xED1A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SharedText" Text="{local:Loc Key='对方看不到'}" Foreground="{StaticResource Muted}" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="HeaderRight" Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button x:Name="StartBtn" Content="{local:Loc Key='开始新会议'}" Style="{StaticResource PrimaryBtn}" FontSize="12" Padding="11,4" Visibility="Collapsed" Click="Start_Click"/>
                    <Button x:Name="StopBtn" Content="{local:Loc Key='结束会议'}" Style="{StaticResource DeleteBtn}" FontSize="12" Padding="11,4" Click="Stop_Click"/>
                    <Button Content="{local:Loc Key='收起'}" Style="{StaticResource GhostBtn}" FontSize="12" Padding="9,4"
                            Foreground="{StaticResource Muted}" ToolTip="{local:Loc Key='收起面板，继续在后台收听'}" Click="Hide_Click" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Meeting-end gentle warning banner -->
            <Border x:Name="EndBanner" Grid.Row="1" Background="#F5FFF5E6" BorderBrush="#55FF9500" BorderThickness="1" CornerRadius="12" Margin="14,0,14,10" Padding="12,10" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="EndText" TextWrapping="Wrap" FontSize="12.5" Foreground="#9A5300"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{local:Loc Key='不结束，继续'}" Style="{StaticResource Btn}" FontSize="12" Padding="10,4" Click="KeepGoing_Click"/>
                        <Button Content="{local:Loc Key='现在结束'}" Style="{StaticResource GhostBtn}" FontSize="12" Padding="10,4"
                                Foreground="#B45309" Margin="6,0,0,0" Click="Stop_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Light Liquid Glass Segmented Switch -->
            <DockPanel Grid.Row="2" Margin="16,0,16,10">
                <CheckBox x:Name="TranslateSwitch" DockPanel.Dock="Right" Content="{local:Loc Key='翻译'}" FontSize="12" Style="{StaticResource Switch}"
                          Visibility="Collapsed" VerticalAlignment="Center" Margin="10,0,0,0" Click="Translate_Click"/>
                <TextBlock x:Name="NotesState" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center"/>
                <Border Background="{StaticResource GlassPillTrack}" BorderBrush="#1816284C" BorderThickness="1" CornerRadius="10" Padding="2" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabLines" Content="{local:Loc Key='逐字稿'}" GroupName="tab" Style="{StaticResource Seg}" FontSize="12" Padding="12,4" IsChecked="True" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabNotes" Content="{local:Loc Key='实时纪要'}" GroupName="tab" Style="{StaticResource Seg}" FontSize="12" Padding="12,4" Checked="Tab_Checked"/>
                    </StackPanel>
                </Border>
            </DockPanel>

            <!-- Body -->
            <Grid Grid.Row="3" Margin="4,0,4,10">
                <ScrollViewer x:Name="LinesScroll" VerticalScrollBarVisibility="Auto" Padding="12,2,12,6">
                    <StackPanel>
                        <ItemsControl x:Name="LinesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#CCFFFFFF" BorderBrush="{StaticResource GlassRim}" BorderThickness="1"
                                            CornerRadius="14" Padding="12,10" Margin="0,0,0,9">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Foreground="{StaticResource Faint}" FontSize="11" VerticalAlignment="Center"/>
                                                <Border x:Name="whoChip" CornerRadius="6" Padding="5,1,6,1" Margin="-5,0,0,0" Background="Transparent"
                                                        HorizontalAlignment="Left" Cursor="Hand" ToolTip="{local:Loc Key='点击给这位发言人改名'}" MouseLeftButtonUp="Who_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" Fill="{Binding WhoBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding Who}" Foreground="{Binding WhoBrush}" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock x:Name="pen" Text="✎" Foreground="{Binding WhoBrush}" FontSize="10.5" Margin="4,0,0,0" Opacity="0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Src}" Foreground="{StaticResource Ink}" FontSize="13.5" LineHeight="21" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Dst}" Visibility="{Binding DstVisibility}" Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Renamable}" Value="False">
                                            <Setter TargetName="whoChip" Property="Cursor" Value="Arrow"/>
                                            <Setter TargetName="whoChip" Property="ToolTip" Value="{x:Null}"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Renamable}" Value="True"/>
                                                <Condition Binding="{Binding IsMouseOver, ElementName=whoChip}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="whoChip" Property="Background" Value="#16007AFF"/>
                                            <Setter TargetName="pen" Property="Opacity" Value="0.9"/>
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Floating Live Speaking Card -->
                        <Border x:Name="LivePanel" Visibility="Collapsed" Background="#F0EEF6FF" BorderBrush="#4D007AFF" BorderThickness="1.2"
                                CornerRadius="14" Padding="13,10" Margin="0,2,0,4">
                            <StackPanel>
                                <TextBlock x:Name="LiveWho" Foreground="{StaticResource Primary}" FontSize="11.5" FontWeight="SemiBold"/>
                                <TextBlock x:Name="LiveSrc" Foreground="{StaticResource Ink}" FontSize="13.5" LineHeight="21" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock x:Name="LiveDst" Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="EmptyHint" FontSize="13" Foreground="{StaticResource Faint}" TextWrapping="Wrap" Margin="4,18,4,0"
                                   Text="{local:Loc Key='电脑里有人说话时，逐字稿会一句句出现在这里。'}"/>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="NotesScroll" VerticalScrollBarVisibility="Auto" Padding="14,2,14,6" Visibility="Collapsed">
                    <ContentControl x:Name="NotesHost"/>
                </ScrollViewer>

                <!-- Light Liquid Glass Ready State -->
                <Border x:Name="ReadyPanel" Background="Transparent" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0,24,36">
                        <Grid Width="84" Height="84" HorizontalAlignment="Center">
                            <Ellipse>
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#44007AFF" Offset="0.5"/>
                                        <GradientStop Color="#00007AFF" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Border Width="58" Height="58" CornerRadius="29" BorderBrush="#99FFFFFF" BorderThickness="1.2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#2FA0FF" Offset="0"/>
                                        <GradientStop Color="#0066E0" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="&#xE720;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{local:Loc Key='准备好了就开始'}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        <TextBlock x:Name="ReadyText" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300" Margin="0,8,0,22" LineHeight="20"/>
                        <Button Click="Start_Click" Style="{StaticResource PrimaryBtn}" Padding="28,10" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#FF5A52" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="{local:Loc Key='开始会议'}" FontSize="14.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
