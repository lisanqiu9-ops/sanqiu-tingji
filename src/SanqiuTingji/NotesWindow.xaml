<Window x:Class="SanqiuTingji.App.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SanqiuTingji.App"
        Foreground="#141824" FontFamily="Microsoft YaHei UI, Segoe UI"
        Title="实时听记" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="CanResizeWithGrip"
        Width="416" Height="640" MinWidth="330" MinHeight="340">
    <Window.Resources>
        <Style TargetType="ResizeGrip">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ResizeGrip">
                        <Grid Width="14" Height="14" Background="Transparent" Margin="0,0,4,4">
                            <Ellipse Width="2.5" Height="2.5" Fill="#8A93A6" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            <Ellipse Width="2.5" Height="2.5" Fill="#8A93A6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,0"/>
                            <Ellipse Width="2.5" Height="2.5" Fill="#8A93A6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean, formal stop-listening button (no trash icon) -->
        <Style x:Key="StopListeningBtn" TargetType="Button">
            <Setter Property="Background" Value="#FAFFFFFF"/>
            <Setter Property="Foreground" Value="#D92D20"/>
            <Setter Property="BorderBrush" Value="#40D92D20"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14D92D20"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#70D92D20"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22D92D20"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Matching bordered icon button for top control bar (unified height, radius, stroke) -->
        <Style x:Key="HeaderIconBtn" TargetType="Button">
            <Setter Property="Background" Value="#FAFFFFFF"/>
            <Setter Property="BorderBrush" Value="#2416284C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#10007AFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#40007AFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1C007AFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Interactive privacy quick-toggle pill -->
        <Style x:Key="PrivacyPillBtn" TargetType="Button">
            <Setter Property="Background" Value="#0E16284C"/>
            <Setter Property="BorderBrush" Value="#1F16284C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="23"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.86"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Light Glass Floating Panel (unified with MainWindow, crisp readability) -->
    <Border x:Name="PanelShell" CornerRadius="20" BorderBrush="#D6DFEE" BorderThickness="1.2" Margin="10">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.25,1">
                <GradientStop Color="#F8FBFDFF" Offset="0"/>
                <GradientStop Color="#F4F8FEFF" Offset="0.55"/>
                <GradientStop Color="#F0F5FDFF" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.16" Color="#0C1C3D"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Control Bar: unified status badge + clock on left, action + minimize on right -->
            <Border Grid.Row="0" BorderBrush="#1416284C" BorderThickness="0,0,0,1" Padding="15,12,13,11">
                <Grid x:Name="Header" Background="Transparent" Cursor="SizeAll">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Unified Status Pill (status dot + label + subtle divider + monospace timer) -->
                    <StackPanel x:Name="HeaderLeft" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                        <Border x:Name="OnAirPill" Height="28" Background="#FAFFFFFF" BorderBrush="#38D92D20" BorderThickness="1"
                                CornerRadius="9" Padding="10,0" VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid x:Name="LiveDotHost" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Ellipse x:Name="LiveDotHalo" Width="10" Height="10" Fill="#2ED92D20"/>
                                    <Ellipse x:Name="LiveDot" Width="6" Height="6" Fill="#D92D20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="StateText" Text="收听中" Foreground="#C8281D" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border x:Name="ClockDivider" Width="1" Height="11" Background="#2216284C" Margin="8,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ClockText" Text="00:00" Foreground="#3B4256" FontSize="12" FontWeight="SemiBold"
                                           FontFamily="Consolas, Microsoft YaHei UI" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="HeaderRight" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button x:Name="StartBtn" Content="开始收听" Style="{StaticResource PrimaryBtn}" Height="28" FontSize="12" Padding="12,0" Visibility="Collapsed" Click="Start_Click"/>
                        <Button x:Name="StopBtn" Style="{StaticResource StopListeningBtn}" Click="Stop_Click" ToolTip="结束本次收听并保存记录">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="8" Height="8" CornerRadius="2" Background="#D92D20" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="结束收听" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource HeaderIconBtn}" Margin="6,0,0,0"
                                ToolTip="最小化（后台继续收听）" Click="Hide_Click" VerticalAlignment="Center">
                            <Canvas Width="10" Height="10">
                                <Path Data="M1.2,5.5 L8.8,5.5" Stroke="#4B5568" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Meeting-end gentle warning banner -->
            <Border x:Name="EndBanner" Grid.Row="1" Background="#F5FFF5E6" BorderBrush="#55FF9500" BorderThickness="1" CornerRadius="12" Margin="14,10,14,0" Padding="12,10" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="EndText" TextWrapping="Wrap" FontSize="12.5" Foreground="#9A5300"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{local:Loc Key='不结束，继续'}" Style="{StaticResource Btn}" FontSize="12" Padding="10,4" Click="KeepGoing_Click"/>
                        <Button Content="结束收听" Style="{StaticResource GhostBtn}" FontSize="12" Padding="10,4"
                                Foreground="#B45309" Margin="6,0,0,0" Click="Stop_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Compact Live Transcript Sub-bar with quick privacy toggle -->
            <DockPanel x:Name="SubBar" Grid.Row="2" Margin="16,9,16,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PrivacyBtn" Style="{StaticResource PrivacyPillBtn}" Click="Privacy_Click" VerticalAlignment="Center" Margin="0,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Canvas Width="13" Height="11" VerticalAlignment="Center" Margin="0,0,5,0">
                                <!-- Eye contour -->
                                <Path x:Name="EyeContour" Data="M1,5.5 C2.8,2.5 5,1.5 6.5,1.5 C8,1.5 10.2,2.5 12,5.5 C10.2,8.5 8,9.5 6.5,9.5 C5,9.5 2.8,8.5 1,5.5 Z"
                                      Stroke="#6B7280" StrokeThickness="1.25" StrokeLineJoin="Round"/>
                                <!-- Eye pupil -->
                                <Ellipse x:Name="EyePupil" Width="3" Height="3" Fill="#6B7280" Canvas.Left="5" Canvas.Top="4"/>
                                <!-- Diagonal slash shown when hidden from screen capture (lit) -->
                                <Path x:Name="EyeSlash" Data="M2,9.8 L11,1.2" Stroke="#007AFF" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                            </Canvas>
                            <TextBlock x:Name="SharedText" Text="对方看不到" Foreground="#6B7280" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <CheckBox x:Name="TranslateSwitch" Content="{local:Loc Key='翻译'}" FontSize="11.5" Style="{StaticResource Switch}"
                              Visibility="Collapsed" VerticalAlignment="Center" Margin="8,0,0,0" Click="Translate_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="实时听记" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LinesCountText" FontSize="11.5" Foreground="{StaticResource Faint}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>

            <!-- Body: Live Transcript Stream -->
            <Grid Grid.Row="3" Margin="4,2,4,10">
                <ScrollViewer x:Name="LinesScroll" VerticalScrollBarVisibility="Auto" Padding="12,4,12,6">
                    <StackPanel>
                        <ItemsControl x:Name="LinesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#EBFFFFFF" BorderBrush="#E2E8F4" BorderThickness="1"
                                            CornerRadius="12" Padding="12,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Foreground="{StaticResource Faint}" FontSize="11" VerticalAlignment="Center"/>
                                                <Border x:Name="whoChip" CornerRadius="6" Padding="5,1,6,1" Margin="-5,0,0,0" Background="Transparent"
                                                        HorizontalAlignment="Left" Cursor="Hand" ToolTip="{local:Loc Key='点击给这位发言人改名'}" MouseLeftButtonUp="Who_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" Fill="{Binding WhoBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding Who}" Foreground="{Binding WhoBrush}" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock x:Name="pen" Text="✎" Foreground="{Binding WhoBrush}" FontSize="10.5" Margin="4,0,0,0" Opacity="0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Src}" Foreground="{StaticResource Ink}" FontSize="13.5" LineHeight="21" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Dst}" Visibility="{Binding DstVisibility}" Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Renamable}" Value="False">
                                            <Setter TargetName="whoChip" Property="Cursor" Value="Arrow"/>
                                            <Setter TargetName="whoChip" Property="ToolTip" Value="{x:Null}"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Renamable}" Value="True"/>
                                                <Condition Binding="{Binding IsMouseOver, ElementName=whoChip}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="whoChip" Property="Background" Value="#16007AFF"/>
                                            <Setter TargetName="pen" Property="Opacity" Value="0.9"/>
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Floating Live Speaking Card -->
                        <Border x:Name="LivePanel" Visibility="Collapsed" Background="#F5EEF6FF" BorderBrush="#4D007AFF" BorderThickness="1.2"
                                CornerRadius="12" Padding="13,10" Margin="0,2,0,4">
                            <StackPanel>
                                <TextBlock x:Name="LiveWho" Foreground="{StaticResource Primary}" FontSize="11.5" FontWeight="SemiBold"/>
                                <TextBlock x:Name="LiveSrc" Foreground="{StaticResource Ink}" FontSize="13.5" LineHeight="21" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock x:Name="LiveDst" Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="EmptyHint" FontSize="13" Foreground="{StaticResource Faint}" TextWrapping="Wrap" Margin="4,18,4,0"
                                   Text="电脑里有人说话时，实时听记会一句句出现在这里。"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Light Liquid Glass Ready State -->
                <Border x:Name="ReadyPanel" Background="Transparent" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0,24,36">
                        <Grid Width="84" Height="84" HorizontalAlignment="Center">
                            <Ellipse>
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#44007AFF" Offset="0.5"/>
                                        <GradientStop Color="#00007AFF" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Border Width="58" Height="58" CornerRadius="29" BorderBrush="#99FFFFFF" BorderThickness="1.2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#2FA0FF" Offset="0"/>
                                        <GradientStop Color="#0066E0" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="&#xE720;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{local:Loc Key='准备好了就开始'}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        <TextBlock x:Name="ReadyText" FontSize="12.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300" Margin="0,8,0,22" LineHeight="20"/>
                        <Button Click="Start_Click" Style="{StaticResource PrimaryBtn}" Padding="28,10" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#FF5A52" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="开始收听" FontSize="14.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
