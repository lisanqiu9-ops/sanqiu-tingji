<Window x:Class="SanqiuTingji.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SanqiuTingji.App"
        Foreground="#141824" FontFamily="Microsoft YaHei UI, Segoe UI"
        Title="三秋听记 · 会议记录" Width="1340" Height="860" MinWidth="820" MinHeight="520"
        WindowStyle="None" Background="#EAF0FA" WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" GlassFrameThickness="0" CornerRadius="16" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="RootShell">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#66EEF4FF" Offset="0"/>
                <GradientStop Color="#48E6EEFB" Offset="0.5"/>
                <GradientStop Color="#5CE3ECFA" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="308"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- L1 Left Floating Liquid Glass Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource GlassSidebarBg}" BorderBrush="{StaticResource GlassRim}"
                BorderThickness="1" CornerRadius="18" Margin="12,12,0,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.07" Color="#0C1933"/>
            </Border.Effect>
            <DockPanel Margin="14,15,10,12">
                <StackPanel DockPanel.Dock="Top" Margin="4,0,6,10">
                    <!-- Brand header + compact Settings glass icon button (no duplicate search icon) -->
                    <DockPanel Margin="0,0,0,2">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Width="32" Height="32" Padding="0"
                                WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center"
                                ToolTip="{local:Loc Key='设置'}" AutomationProperties.Name="{local:Loc Key='设置'}" Click="Settings_Click">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14.5" Foreground="{StaticResource Muted}"/>
                        </Button>
                        <Image x:Name="Logo" Width="32" Height="32" Margin="0,0,10,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="AppName" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                            <TextBlock Text="本地转写 · 智能纪要" FontSize="10.5" Foreground="{StaticResource Faint}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Primary Action: Start Listening -->
                    <Button x:Name="ListenBtn" Content="{local:Loc Key='开始收听'}" Style="{StaticResource PrimaryBtn}"
                            Padding="0,10" Margin="0,14,0,0" WindowChrome.IsHitTestVisibleInChrome="True" Click="Listen_Click"/>

                    <!-- Secondary Tools: Glass Tiles with refined 1.75px linear vector icons -->
                    <UniformGrid Columns="3" Margin="0,9,0,0">
                        <Button Style="{StaticResource Btn}" Padding="2,9,2,8" Margin="0,0,4,0" ToolTip="{local:Loc Key='导入本地录音、视频或视频链接'}" Click="ImportMedia_Click">
                            <StackPanel>
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M4,13 V15 A5,5 0 0 0 9,20 H15 A5,5 0 0 0 20,15 V13" Stroke="{StaticResource Primary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        <Path Data="M8,10 V13 M12,4 V14 M16,8 V13 M9.5,6.5 L12,4 L14.5,6.5" Stroke="{StaticResource Primary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{local:Loc Key='导入音视频'}" FontSize="11.5" Margin="0,5,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn}" Padding="2,9,2,8" Margin="2,0,2,0" ToolTip="{local:Loc Key='纪要模板中心：选默认模板、自定义模板'}" Click="Templates_Click">
                            <StackPanel>
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Rectangle Canvas.Left="3.5" Canvas.Top="3.5" Width="17" Height="17" RadiusX="3" RadiusY="3" Stroke="{StaticResource Primary}" StrokeThickness="1.8"/>
                                        <Path Data="M3.5,9.5 H20.5 M9.5,9.5 V20.5 M13,13.5 H17 M13,17 H16" Stroke="{StaticResource Primary}" StrokeThickness="1.8" StrokeStartLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{local:Loc Key='纪要模板'}" FontSize="11.5" Margin="0,5,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn}" Padding="2,9,2,8" Margin="4,0,0,0" ToolTip="{local:Loc Key='人名、产品名、术语自动纠偏词库'}" Click="Glossary_Click">
                            <StackPanel>
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M4.5,5.5 A2.5,2.5 0 0 1 7,3 H19.5 V20 H7 A2.5,2.5 0 0 0 4.5,22.5 Z" Stroke="{StaticResource Primary}" StrokeThickness="1.8" StrokeLineJoin="Round"/>
                                        <Path Data="M4.5,19.5 A2.5,2.5 0 0 1 7,17 H19.5 M12,3 V10 L14.2,8.5 L16.4,10 V3" Stroke="{StaticResource Primary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{local:Loc Key='词库'}" FontSize="11.5" Margin="0,5,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <!-- Search Field with one-click Clear button -->
                    <Grid Margin="0,12,0,0">
                        <TextBox x:Name="SearchBox" Style="{StaticResource Field}" Padding="30,7,28,7" TextChanged="Search_Changed" KeyDown="Search_KeyDown"/>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource Faint}" FontSize="12.5"
                                   Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBlock x:Name="SearchHint" Text="{local:Loc Key='搜索标题或内容'}" Foreground="#98A2B5" FontSize="12.5" Margin="31,0,26,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Button x:Name="ClearSearchBtn" Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9.5"
                                Style="{StaticResource GhostBtn}" Foreground="{StaticResource Faint}" Padding="5" Width="22" Height="22"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"
                                ToolTip="清空搜索 (Esc)" Click="ClearSearch_Click"/>
                    </Grid>

                    <!-- Liquid Glass Sliding Segmented Scope Control -->
                    <Border Background="{StaticResource GlassPillTrack}" BorderBrush="#1A16284C" BorderThickness="1" CornerRadius="11" Padding="2" Margin="0,10,0,0">
                        <Grid x:Name="ScopeTrack" ClipToBounds="True" SizeChanged="ScopeTrack_SizeChanged">
                            <Border x:Name="ScopeThumb" Background="#F5FFFFFF" BorderBrush="{StaticResource GlassRim}" BorderThickness="1"
                                    CornerRadius="9" HorizontalAlignment="Left" VerticalAlignment="Stretch" Visibility="Collapsed">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.10" Color="#0E1D3B"/>
                                </Border.Effect>
                            </Border>
                            <UniformGrid Columns="3">
                                <RadioButton x:Name="ActiveScope" Content="{local:Loc Key='未归档'}" Tag="0" GroupName="archiveScope" Style="{StaticResource LiquidSegItem}" FontSize="11.5" IsChecked="True" Checked="LibraryScope_Checked" ToolTip="{local:Loc Key='未归档'}"/>
                                <RadioButton x:Name="AllScope" Content="{local:Loc Key='全部'}" Tag="1" GroupName="archiveScope" Style="{StaticResource LiquidSegItem}" FontSize="11.5" Checked="LibraryScope_Checked" ToolTip="{local:Loc Key='包含归档'}"/>
                                <RadioButton x:Name="ArchivedScope" Content="{local:Loc Key='已归档'}" Tag="2" GroupName="archiveScope" Style="{StaticResource LiquidSegItem}" FontSize="11.5" Checked="LibraryScope_Checked" ToolTip="{local:Loc Key='仅看归档'}"/>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <DockPanel Margin="4,14,0,0">
                        <Button DockPanel.Dock="Right" Content="＋" Width="26" FontSize="16" Padding="2" Style="{StaticResource GhostBtn}" Foreground="{StaticResource Muted}" ToolTip="{local:Loc Key='新建分组'}" AutomationProperties.Name="{local:Loc Key='新建分组'}" Click="NewGroup_Click"/>
                        <TextBlock Text="{local:Loc Key='分组'}" Foreground="{StaticResource Faint}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>

                <!-- Grouped Sessions Tree (clean full-height sidebar; engine & storage live in Settings) -->
                <TreeView x:Name="SessionList" BorderThickness="0" Background="Transparent" SelectedItemChanged="Session_Selected"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TreeView.Resources>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <EventSetter Event="ContextMenuOpening" Handler="TreeMenu_Opening"/>
                            <Setter Property="ContextMenu"><Setter.Value><ContextMenu/></Setter.Value></Setter>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TreeViewItem">
                                        <StackPanel>
                                            <Border x:Name="surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                                    CornerRadius="10" Margin="0,1.5,5,1.5" Padding="4,7,4,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                                                    <ToggleButton x:Name="expander" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Visibility="Hidden" Width="16" Height="24" Cursor="Hand" VerticalAlignment="Center">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <TextBlock x:Name="arrow" Text="›" FontSize="16" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin=".5,.5">
                                                                    <TextBlock.RenderTransform>
                                                                        <RotateTransform x:Name="arrowRot" Angle="0"/>
                                                                    </TextBlock.RenderTransform>
                                                                </TextBlock>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Trigger.EnterActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetName="arrowRot" Storyboard.TargetProperty="Angle" To="90" Duration="0:0:0.18">
                                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                                    </DoubleAnimation>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </Trigger.EnterActions>
                                                                        <Trigger.ExitActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetName="arrowRot" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.18">
                                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                                    </DoubleAnimation>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </Trigger.ExitActions>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>
                                                    <ContentPresenter Grid.Column="1" ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                    <Button x:Name="menuBtn" Grid.Column="2" Content="⋯" FontSize="16" Foreground="{StaticResource Faint}" Style="{StaticResource GhostBtn}" Padding="1" Width="23" VerticalAlignment="Center" Click="TreeMenu_Click" ToolTip="{local:Loc Key='更多操作'}" AutomationProperties.Name="{local:Loc Key='更多操作'}"/>
                                                </Grid>
                                            </Border>
                                            <ItemsPresenter x:Name="children" Margin="24,0,0,0"/>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsExpanded" Value="False"><Setter TargetName="children" Property="Visibility" Value="Collapsed"/></Trigger>
                                            <DataTrigger Binding="{Binding IsGroup}" Value="True"><Setter TargetName="expander" Property="Visibility" Value="Visible"/></DataTrigger>
                                            <DataTrigger Binding="{Binding ShowMenu}" Value="False"><Setter TargetName="menuBtn" Property="Visibility" Value="Hidden"/></DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="surface" Property="Background" Value="#68FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="surface" Property="Background" Value="#D8FFFFFF"/>
                                                <Setter TargetName="surface" Property="BorderBrush" Value="#55007AFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <HierarchicalDataTemplate DataType="{x:Type local:SessionGroupNode}" ItemsSource="{Binding Children}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="21"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource Faint}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="11" Foreground="{StaticResource Faint}" Margin="6,0,5,0" VerticalAlignment="Center"/>
                            </Grid>
                        </HierarchicalDataTemplate>
                        <DataTemplate DataType="{x:Type local:SessionRow}">
                            <StackPanel Margin="2,1,0,1">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Background="#1616284C" CornerRadius="5" Padding="5,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Archived}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                        <TextBlock Text="{local:Loc Key='已归档'}" FontSize="10" Foreground="{StaticResource Muted}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                </DockPanel>
                                <DockPanel Margin="0,3,0,0">
                                    <Border DockPanel.Dock="Right" Background="#16007AFF" CornerRadius="5" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasAudio}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                        <TextBlock Text="有录音" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource Primary}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{StaticResource Faint}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </DockPanel>
        </Border>

        <!-- L1 Right Frosted Main Canvas -->
        <Border Grid.Column="1" Background="{StaticResource GlassCanvasBg}" BorderBrush="{StaticResource GlassRim}"
                BorderThickness="1" CornerRadius="18" Margin="12,12,12,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Seamless Glass Titlebar with Live Recording Pill + Caption Controls -->
                <DockPanel Grid.Row="0" Margin="18,6,10,0" Background="Transparent">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource CaptionBtn}" ToolTip="最小化" Click="Min_Click">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                        <Button x:Name="MaxBtn" Style="{StaticResource CaptionBtn}" ToolTip="最大化 / 还原" Click="Max_Click">
                            <TextBlock x:Name="MaxGlyph" Text="&#xE922;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                        <Button Style="{StaticResource CaptionCloseBtn}" ToolTip="关闭窗口（保留在托盘）" Click="Close_Click">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"/>
                        </Button>
                    </StackPanel>

                    <!-- Floating live-listening return pill so user never loses the minimized panel -->
                    <Button x:Name="TopLivePill" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True" Cursor="Hand" FocusVisualStyle="{x:Null}" Click="Live_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="p" Background="#2228CD41" BorderBrush="#5528CD41" BorderThickness="1" CornerRadius="13" Padding="11,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="TopLiveDot" Width="7" Height="7" Fill="#28CD41" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="正在后台收听 · 点击展开实时面板" FontSize="12" FontWeight="SemiBold" Foreground="#177A28" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="p" Property="Background" Value="#3428CD41"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DockPanel>

                <!-- Main Meeting Content Area -->
                <Grid Grid.Row="1">
                    <StackPanel x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                        <Border Width="56" Height="56" CornerRadius="18" Background="#D8FFFFFF" BorderBrush="{StaticResource GlassRim}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock Text="&#xE720;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource Primary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="EmptyTitle" Text="{local:Loc Key='还没有会议记录'}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource Ink}"/>
                        <TextBlock x:Name="EmptyHint" Style="{StaticResource Helper}" TextAlignment="Center" Margin="0,6,0,0"
                                   Text="点左上角「开始收听」或「导入音视频」，本地识别的逐字稿与智能纪要会自动整理在这里。"/>
                    </StackPanel>

                    <DockPanel x:Name="Detail" Visibility="Collapsed" Margin="28,4,28,18">
                        <StackPanel DockPanel.Dock="Top">
                            <!-- Row 1: Pure Editable Meeting Title (clean right margin) -->
                            <TextBox x:Name="TitleBox" Style="{StaticResource TitleField}" FontSize="23" Margin="-7,0,0,0"
                                     Foreground="{StaticResource Ink}" LostFocus="Title_LostFocus" KeyDown="Title_KeyDown" ToolTip="{local:Loc Key='点击修改标题'}"/>

                            <!-- Row 2: Natural Meta Line + Subtle Inline Speakers Link -->
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,15" VerticalAlignment="Center">
                                <TextBlock x:Name="MetaText" Foreground="{StaticResource Faint}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                <StackPanel x:Name="SpeakersPanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                                    <TextBlock Text="|" Foreground="#C6CFDF" FontSize="12" Margin="10,0,6,0" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource GhostBtn}" Background="#10007AFF" Padding="8,2" VerticalAlignment="Center"
                                            Click="Speakers_Click" ToolTip="{local:Loc Key='管理发言人'}" AutomationProperties.Name="{local:Loc Key='管理发言人'}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="发言人：" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SpeakersPreview" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ink}" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SpeakersCount" FontSize="12" Foreground="{StaticResource Muted}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="›" Foreground="{StaticResource Primary}" FontSize="13" FontWeight="SemiBold" Margin="5,-1,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <!-- Row 3: Single-Level Unified Toolbar (Tabs LEFT | 模板 / 生成纪要-重新生成 / 手工工坊 / 导出 RIGHT) -->
                            <Grid x:Name="HeaderToolbar" Margin="0,0,0,14" SizeChanged="HeaderToolbar_SizeChanged">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Sliding Liquid Glass Tab Switcher (纪要 / 逐字稿 / 原声回放) -->
                                <Border Background="{StaticResource GlassPillTrack}" BorderBrush="#1A16284C" BorderThickness="1" CornerRadius="11" Padding="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Grid x:Name="TabTrack" ClipToBounds="True" SizeChanged="TabTrack_SizeChanged">
                                        <Border x:Name="TabThumb" Background="#F5FFFFFF" BorderBrush="{StaticResource GlassRim}" BorderThickness="1"
                                                CornerRadius="9" HorizontalAlignment="Left" VerticalAlignment="Stretch" Visibility="Collapsed">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.10" Color="#0E1D3B"/>
                                            </Border.Effect>
                                        </Border>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="TabNotes" Content="{local:Loc Key='纪要'}" GroupName="d" Style="{StaticResource LiquidSegItem}" MinWidth="64" IsChecked="True" Checked="Tab_Checked"/>
                                            <RadioButton x:Name="TabLines" Content="{local:Loc Key='逐字稿'}" GroupName="d" Style="{StaticResource LiquidSegItem}" MinWidth="72" Checked="Tab_Checked"/>
                                            <RadioButton x:Name="TabAudio" GroupName="d" Style="{StaticResource LiquidSegItem}" MinWidth="86" Checked="Tab_Checked">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="原声回放" VerticalAlignment="Center"/>
                                                    <Ellipse x:Name="TabAudioDot" Width="5.5" Height="5.5" Fill="{StaticResource Primary}" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                </StackPanel>
                                            </RadioButton>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Single-Level Actions: 模板 / 重新生成 / 手工工坊 / 导出 -->
                                <StackPanel x:Name="NotesTools" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{local:Loc Key='模板'}" Foreground="{StaticResource Faint}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="TemplateBox" MinWidth="112" MaxWidth="168" MaxDropDownHeight="420"
                                              ToolTip="{local:Loc Key='这场会议的纪要模板'}" SelectionChanged="Template_Changed"/>
                                    <Button x:Name="NotesBtn" Content="生成纪要" Style="{StaticResource PrimaryBtn}" Padding="14,7" Click="Generate_Click" Margin="8,0,0,0"/>
                                    <Button x:Name="WorkshopBtn" Content="手工工坊" Style="{StaticResource Btn}" Padding="12,7" Margin="8,0,0,0"
                                            Click="Workshop_Click" ToolTip="打开手工纪要工坊（复制提示词 / 粘贴回填）"/>
                                    <Button x:Name="ExportBtn" Content="导出" Style="{StaticResource Btn}" Padding="13,7" Margin="8,0,0,0"
                                            Click="Export_Click" ToolTip="导出为 Word / Markdown / 文本"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="LibraryError" Foreground="{StaticResource Warn}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8"/>
                        </StackPanel>

                        <DockPanel>
                            <StackPanel x:Name="SearchNavigation" DockPanel.Dock="Top" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,8">
                                <TextBlock x:Name="SearchCount" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,10,0"/>
                                <Button Content="↑" Style="{StaticResource GhostBtn}" Click="PreviousMatch_Click" Padding="9,3" ToolTip="{local:Loc Key='上一个匹配'}" AutomationProperties.Name="{local:Loc Key='上一个匹配'}"/>
                                <Button Content="↓" Style="{StaticResource GhostBtn}" Click="NextMatch_Click" Padding="9,3" ToolTip="{local:Loc Key='下一个匹配'}" AutomationProperties.Name="{local:Loc Key='下一个匹配'}"/>
                            </StackPanel>

                            <Grid>
                                <DockPanel x:Name="NotesPane">
                                    <!-- Liquid Glass Live Progress Bar while CLI is running -->
                                    <Border x:Name="CliProgressBanner" DockPanel.Dock="Top" Visibility="Collapsed"
                                            Background="#DCEAF5FF" BorderBrush="{StaticResource GlassRim}" BorderThickness="1" CornerRadius="14"
                                            Margin="0,0,6,14" Padding="16,12,14,11">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.08" Color="#0051D5"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <DockPanel>
                                                <Button x:Name="CliCancelBtn" DockPanel.Dock="Right" Content="取消"
                                                        Style="{StaticResource GhostBtn}" Padding="10,3" Foreground="{StaticResource Muted}" Click="CliCancel_Click"/>
                                                <TextBlock x:Name="CliElapsedText" DockPanel.Dock="Right" Text="00:00"
                                                           Foreground="{StaticResource Muted}" FontSize="12" FontFamily="Consolas, Microsoft YaHei UI"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse x:Name="CliPulseDot" Width="8" Height="8" Fill="{StaticResource Primary}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                                    <TextBlock x:Name="CliStatusText" Text="正在通过本地 CLI 静默整理纪要…"
                                                               Foreground="#0E2D5C" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <Border Height="3.5" Background="#24007AFF" CornerRadius="2" Margin="0,10,0,0" ClipToBounds="True">
                                                <Border x:Name="CliSweepBar" Width="150" Height="3.5" CornerRadius="2" HorizontalAlignment="Left">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#00007AFF" Offset="0"/>
                                                            <GradientStop Color="#007AFF" Offset="0.5"/>
                                                            <GradientStop Color="#00007AFF" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Border.RenderTransform>
                                                        <TranslateTransform x:Name="CliSweepTransform" X="-150"/>
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Transient Success Banner -->
                                    <Border x:Name="CliDoneBanner" DockPanel.Dock="Top" Visibility="Collapsed"
                                            Background="#DDF0FBF3" BorderBrush="#6628CD41" BorderThickness="1" CornerRadius="14"
                                            Margin="0,0,6,14" Padding="15,10">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="{StaticResource OnAir}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="CliDoneText" Foreground="#176B2C" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <ScrollViewer x:Name="NotesScroll" VerticalScrollBarVisibility="Auto">
                                        <ContentControl x:Name="NotesHost" Margin="0,0,6,0"/>
                                    </ScrollViewer>
                                </DockPanel>

                                <!-- Transcript Card (Virtualized for 6000+ lines at 60fps, NO per-row shadows/animations) -->
                                <Border x:Name="LinesScroll" Style="{StaticResource PanelFlat}" Padding="0" Margin="0" Visibility="Collapsed">
                                    <ItemsControl x:Name="LinesList" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard"
                                                  VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                                        <ItemsControl.Template>
                                            <ControlTemplate TargetType="ItemsControl">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True" Focusable="False" Padding="0,18">
                                                    <ItemsPresenter/>
                                                </ScrollViewer>
                                            </ControlTemplate>
                                        </ItemsControl.Template>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="22,0,22,14">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="96"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Who}" Foreground="{Binding WhoBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Time}" Foreground="{StaticResource Faint}" FontSize="11" Margin="0,2,0,0"
                                                                       Cursor="Hand" ToolTip="点击跳转到此处播放原声" MouseLeftButtonUp="TranscriptTime_Click"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1">
                                                            <local:SelectableText Text="{Binding Src}" Marks="{Binding Fixes}" FontSize="14"
                                                                                  ContextMenuOpening="Src_ContextMenuOpening" Loaded="LineBox_Loaded"/>
                                                            <local:SelectableText Text="{Binding Dst}" Visibility="{Binding DstVisibility}" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,3,0,0"
                                                                                  Loaded="LineBox_Loaded"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Content="✎" Style="{StaticResource GhostBtn}" FontSize="12" Foreground="{StaticResource Faint}"
                                                                Padding="6,2" VerticalAlignment="Top" Margin="8,-2,0,0"
                                                                ToolTip="原地纠偏并加入词库" Click="LineInlineEdit_Click"/>
                                                    </Grid>

                                                    <!-- Way A: Compact In-Place Transcript Correction Strip (NO modal!) -->
                                                    <Border Visibility="{Binding EditVisibility}" Margin="96,8,0,2" Padding="12,9"
                                                            Background="#FAFFFFFF" BorderBrush="#66007AFF" BorderThickness="1.2" CornerRadius="11">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.08" Color="#0051D5"/>
                                                        </Border.Effect>
                                                        <StackPanel>
                                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="误识" FontSize="11.5" Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                                <TextBox Text="{Binding EditHeard, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"
                                                                         Width="126" Padding="8,4" FontSize="12.5" Tag="原识别词" Margin="0,0,8,0"/>
                                                                <TextBlock Text="→ 改为" FontSize="11.5" Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                                <TextBox Text="{Binding EditRight, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}"
                                                                         Width="136" Padding="8,4" FontSize="12.5" Tag="正确写法" Margin="0,0,10,0"/>
                                                                <TextBlock Text="分类" FontSize="11.5" Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                                <ComboBox IsEditable="True" Width="118" FontSize="12" Text="{Binding EditGroup, UpdateSourceTrigger=PropertyChanged}"
                                                                          Loaded="InlineCategoryCombo_Loaded" ToolTip="留空为通用词条，或选择/输入分类如「电力专业」"/>
                                                            </WrapPanel>
                                                            <DockPanel Margin="0,8,0,0">
                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                    <Button Content="取消" Style="{StaticResource Btn}" FontSize="11.5" Padding="10,4" Margin="0,0,6,0" Click="LineInlineCancel_Click"/>
                                                                    <Button Content="保存并入库" Style="{StaticResource PrimaryBtn}" FontSize="11.5" Padding="12,4" Click="LineInlineSave_Click"/>
                                                                </StackPanel>
                                                                <CheckBox IsChecked="{Binding EditReplaceAll}" Content="{Binding EditMatchHint}" FontSize="11.5"
                                                                          Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                                            </DockPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <!-- Audio Playback & Bidirectional Sync Pane -->
                                <Grid x:Name="AudioPane" Visibility="Collapsed">
                                    <!-- When audio exists -->
                                    <DockPanel x:Name="AudioAvailablePanel">
                                        <!-- Top Glass Player Card -->
                                        <Border DockPanel.Dock="Top" Background="#EBF8FBFF" BorderBrush="#38007AFF" BorderThickness="1"
                                                CornerRadius="16" Padding="18,14,18,14" Margin="0,0,0,12">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.06" Color="#0051D5"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <!-- Audio file metadata & independent delete -->
                                                <DockPanel Margin="0,0,0,10">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Button Content="导出音频" Style="{StaticResource Btn}" FontSize="12" Padding="10,4" Margin="0,0,8,0" Click="ExportAudio_Click"/>
                                                        <Button Content="仅删录音（保留纪要）" Style="{StaticResource DeleteBtn}" FontSize="12" Padding="10,4" Click="DeleteAudio_Click"/>
                                                    </StackPanel>
                                                    <Border Background="#1416284C" CornerRadius="8" Padding="9,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock x:Name="AudioMetaBadge" Text="M4A" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                                                    </Border>
                                                </DockPanel>

                                                <!-- Interactive Waveform Bar -->
                                                <Border Background="#96FFFFFF" BorderBrush="{StaticResource GlassRim}" BorderThickness="1" CornerRadius="11" Padding="10,8" Margin="0,0,0,10">
                                                    <Canvas x:Name="WaveformCanvas" Height="46" Background="Transparent" Cursor="Hand"
                                                            SizeChanged="WaveformCanvas_SizeChanged"
                                                            MouseLeftButtonDown="WaveformCanvas_MouseDown"
                                                            MouseMove="WaveformCanvas_MouseMove"
                                                            MouseLeftButtonUp="WaveformCanvas_MouseUp"/>
                                                </Border>

                                                <!-- Playback Controls + Speed + Auto-follow -->
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="{StaticResource GlassPillTrack}" CornerRadius="9" Padding="2" Margin="0,0,10,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <RadioButton Content="0.75x" Tag="0.75" GroupName="spd" Style="{StaticResource Seg}" FontSize="11" Padding="7,3" Checked="AudioSpeed_Checked"/>
                                                                <RadioButton Content="1.0x" Tag="1.0" GroupName="spd" Style="{StaticResource Seg}" FontSize="11" Padding="7,3" IsChecked="True" Checked="AudioSpeed_Checked"/>
                                                                <RadioButton Content="1.25x" Tag="1.25" GroupName="spd" Style="{StaticResource Seg}" FontSize="11" Padding="7,3" Checked="AudioSpeed_Checked"/>
                                                                <RadioButton Content="1.5x" Tag="1.5" GroupName="spd" Style="{StaticResource Seg}" FontSize="11" Padding="7,3" Checked="AudioSpeed_Checked"/>
                                                                <RadioButton Content="2.0x" Tag="2.0" GroupName="spd" Style="{StaticResource Seg}" FontSize="11" Padding="7,3" Checked="AudioSpeed_Checked"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <CheckBox x:Name="AudioFollowToggle" Content="自动跟随" IsChecked="True" FontSize="12" Foreground="{StaticResource Primary}"
                                                                  VerticalAlignment="Center" Checked="AudioFollow_Changed" Unchecked="AudioFollow_Changed"/>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="↺ 10s" Style="{StaticResource Btn}" FontSize="11.5" Padding="9,5" Margin="0,0,8,0" Click="AudioSkipBack_Click"/>
                                                        <Button Style="{StaticResource PrimaryBtn}" Width="38" Height="38" Padding="0" Click="AudioPlayPause_Click" ToolTip="播放 / 暂停">
                                                            <TextBlock x:Name="AudioPlayGlyph" Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="White" Margin="1,0,0,0"/>
                                                        </Button>
                                                        <Button Content="10s ↻" Style="{StaticResource Btn}" FontSize="11.5" Padding="9,5" Margin="8,0,12,0" Click="AudioSkipForward_Click"/>
                                                        <TextBlock x:Name="AudioCurrentTime" Text="00:00" FontSize="13" FontWeight="SemiBold" FontFamily="Consolas, Microsoft YaHei UI" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="AudioTotalTime" Text="/ 00:00" FontSize="12.5" FontFamily="Consolas, Microsoft YaHei UI" Foreground="{StaticResource Faint}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Synchronized Click-to-Seek Transcript -->
                                        <Border Style="{StaticResource PanelFlat}" Padding="0" Margin="0">
                                            <ListBox x:Name="AudioLinesList" Background="Transparent" BorderThickness="0"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                                                     Padding="12,12">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                        <Setter Property="Padding" Value="0"/>
                                                        <Setter Property="Margin" Value="0,0,0,6"/>
                                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <ContentPresenter/>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="rowCard" CornerRadius="12" Padding="12,9" Background="#98FFFFFF" BorderBrush="#1216284C" BorderThickness="1"
                                                                Cursor="Hand" MouseLeftButtonUp="AudioLine_Click" ToolTip="点击跳转到此处播放">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="62"/>
                                                                    <ColumnDefinition Width="86"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border x:Name="tsBadge" Background="#1216284C" CornerRadius="7" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                                    <TextBlock x:Name="tsText" Text="{Binding Timestamp}" FontSize="11.5" FontWeight="SemiBold" FontFamily="Consolas, Microsoft YaHei UI" Foreground="{StaticResource Muted}"/>
                                                                </Border>
                                                                <TextBlock Grid.Column="1" Text="{Binding Who}" Foreground="{Binding WhoBrush}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,8,0"/>
                                                                <TextBlock x:Name="bodyText" Grid.Column="2" Text="{Binding Text}" Foreground="{StaticResource Ink}" FontSize="13.5" TextWrapping="Wrap" LineHeight="21"/>
                                                            </Grid>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="rowCard" Property="Background" Value="#EEFFFFFF"/>
                                                                <Setter TargetName="rowCard" Property="BorderBrush" Value="#40007AFF"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter TargetName="rowCard" Property="Background" Value="#EBF4FF"/>
                                                                <Setter TargetName="rowCard" Property="BorderBrush" Value="#70007AFF"/>
                                                                <Setter TargetName="tsBadge" Property="Background" Value="{StaticResource Primary}"/>
                                                                <Setter TargetName="tsText" Property="Foreground" Value="White"/>
                                                                <Setter TargetName="bodyText" Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </DockPanel>

                                    <!-- When no audio file exists -->
                                    <Border x:Name="AudioEmptyPanel" Style="{StaticResource PanelFlat}" Visibility="Collapsed" Padding="32">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                                            <Border Width="52" Height="52" CornerRadius="16" Background="#16007AFF" HorizontalAlignment="Center" Margin="0,0,0,14">
                                                <TextBlock Text="&#xE767;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource Primary}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock x:Name="AudioEmptyTitle" Text="本场会议暂无原始录音" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="AudioEmptyHint" Style="{StaticResource Helper}" TextAlignment="Center" Margin="0,8,0,0"
                                                       Text="录音可能已被手动清理，或录制时未开启保存录音。所有逐字稿与会议纪要均完整保留。"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </DockPanel>
                    </DockPanel>

                    <!-- Bottom-Center macOS Liquid Glass In-App Toast Pill -->
                    <Border x:Name="GlassToast" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,22" Background="#E6141824" BorderBrush="{StaticResource DarkGlassRim}" BorderThickness="1"
                            CornerRadius="18" Padding="18,9" IsHitTestVisible="False">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.28" Color="#040814"/>
                        </Border.Effect>
                        <TextBlock x:Name="GlassToastText" Foreground="White" FontSize="12.5" FontWeight="Medium"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
