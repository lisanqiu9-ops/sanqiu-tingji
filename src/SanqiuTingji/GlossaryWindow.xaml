<Window x:Class="SanqiuTingji.App.GlossaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SanqiuTingji.App"
        Foreground="#1E2235" FontFamily="Microsoft YaHei UI, Segoe UI"
        Title="{local:Loc Key='词库'}" Width="1120" Height="700" MinWidth="900" MinHeight="540"
        Background="#F5F6FA" WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource SecondaryGlassBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="218"/>
            <ColumnDefinition Width="278"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Column 1: Category Directory Tree -->
        <Border Grid.Column="0" Background="{StaticResource GlassSidebarBg}" BorderBrush="{StaticResource GlassRim}"
                BorderThickness="1" CornerRadius="16" Margin="10,10,0,10">
            <DockPanel Margin="12,14,10,12">
                <StackPanel DockPanel.Dock="Top" Margin="2,0,2,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="＋ 新建" Style="{StaticResource GhostBtn}"
                                Background="#16007AFF" Foreground="{StaticResource Primary}" FontSize="11.5" FontWeight="SemiBold"
                                Padding="9,3" ToolTip="新建词库分类目录（如「电力专业」「参会人名」）" Click="ToggleNewCategory_Click"/>
                        <TextBlock Text="词库分类" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Inline New Category Input Bar (no extra popup!) -->
                    <Border x:Name="NewCategoryBar" Visibility="Collapsed" Margin="0,9,0,0" Padding="8,7"
                            Background="#FAFFFFFF" BorderBrush="#66007AFF" BorderThickness="1.2" CornerRadius="10">
                        <StackPanel>
                            <TextBox x:Name="NewCategoryBox" Style="{StaticResource Field}" Tag="输入分类名，如：电力专业"
                                     FontSize="12" Padding="8,5" KeyDown="NewCategoryBox_KeyDown"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                <Button Content="取消" Style="{StaticResource GhostBtn}" FontSize="11" Padding="8,2" Margin="0,0,4,0" Click="CancelNewCategory_Click"/>
                                <Button Content="确定" Style="{StaticResource PrimaryBtn}" FontSize="11" Padding="10,3" Click="ConfirmNewCategory_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Bottom Category-aware Import / Export -->
                <StackPanel DockPanel.Dock="Bottom" Margin="2,10,2,0">
                    <Border Height="1" Background="#1416284C" Margin="0,0,0,10"/>
                    <Button x:Name="ImportBtn" Content="↑ 导入词库" Style="{StaticResource Btn}"
                            Foreground="{StaticResource Primary}" BorderBrush="#40007AFF" Background="#12007AFF"
                            FontSize="12" FontWeight="SemiBold" Padding="8,7" Click="Import_Click"/>
                    <Button x:Name="ExportBtn" Content="↓ 导出当前分类 / 全部" Style="{StaticResource Btn}"
                            FontSize="12" Padding="8,7" Margin="0,7,0,0" Click="Export_Click"/>
                    <TextBlock x:Name="CountText" Style="{StaticResource Helper}" Margin="2,8,0,0" FontSize="11"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="CategoryHost"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Column 2: Terms inside Selected Category -->
        <Border Grid.Column="1" Background="#D8FFFFFF" BorderBrush="{StaticResource GlassRim}"
                BorderThickness="1" CornerRadius="16" Margin="10,10,0,10">
            <DockPanel Margin="12,14,10,12">
                <StackPanel DockPanel.Dock="Top" Margin="2,0,2,10">
                    <DockPanel>
                        <Button x:Name="ManageCategoryBtn" DockPanel.Dock="Right" Content="管理分类 ▾" Style="{StaticResource GhostBtn}"
                                Foreground="{StaticResource Primary}" FontSize="11.5" Padding="6,2" Visibility="Collapsed"
                                Click="ManageCategory_Click"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="CategoryHeaderText" Text="全部词条" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                            <TextBlock x:Name="CategoryCountText" Text="· 0 条" FontSize="11.5" Foreground="{StaticResource Faint}" Margin="5,1,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="CategoryScopeText" FontSize="11" Foreground="{StaticResource Faint}" Margin="0,3,0,0" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                    <TextBox x:Name="SearchBox" Style="{StaticResource Field}" Tag="{local:Loc Key='搜索词条'}" Margin="0,10,0,0" TextChanged="Search_Changed"/>
                </StackPanel>

                <Button x:Name="AddTermBtn" DockPanel.Dock="Bottom" Content="＋ 添加词条" Style="{StaticResource PrimaryBtn}"
                        Margin="2,10,2,0" Padding="0,8" Click="New_Click"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ListHost"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Column 3: One Term Detail Editor -->
        <DockPanel Grid.Column="2" Margin="20,16,20,14">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="DeleteBtn" Content="{local:Loc Key='删除'}" Style="{StaticResource DeleteBtn}" Margin="0,0,8,0" Click="Delete_Click"/>
                    <Button x:Name="SaveBtn" Content="{local:Loc Key='保存'}" Style="{StaticResource PrimaryBtn}" MinWidth="74" Click="Save_Click"/>
                </StackPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="340"/>
                        <Border x:Name="DetailCategoryBadge" Background="#16007AFF" BorderBrush="#33007AFF" BorderThickness="1"
                                CornerRadius="9" Padding="9,3" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="DetailCategoryText" Text="通用" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Primary}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="SavedText" FontSize="12" Foreground="#22B07D" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,0">
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <!-- Row 1: Spelling + Category side-by-side at the VERY TOP -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="210"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{local:Loc Key='正确写法'}" FontWeight="SemiBold"/>
                                    <TextBox x:Name="TextBox" Style="{StaticResource Field}" Tag="比如：电力看价、迎峰度夏度冬" Margin="0,6,0,0" TextChanged="Field_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="所属分类" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="GroupBox" IsEditable="True" Margin="0,6,0,0" MinHeight="34"
                                              TextBoxBase.TextChanged="Field_Changed" SelectionChanged="Group_Selected"
                                              ToolTip="留空为「通用 / 未分类」，可选择已有分类或直接输入新分类名"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{local:Loc Key='常被听成'}" FontWeight="SemiBold" Margin="0,15,0,0"/>
                            <TextBox x:Name="MisheardBox" Style="{StaticResource Field}" Tag="比如：电力砍价，电力看家" Margin="0,6,0,0" TextChanged="Field_Changed"/>
                            <TextBlock Style="{StaticResource Helper}" TextWrapping="Wrap"
                                       Text="{local:Loc Key='识别成这些写法时，一律改成正确写法。多个用逗号分隔。'}"/>

                            <TextBlock Text="{local:Loc Key='说明'}" FontWeight="SemiBold" Margin="0,15,0,0"/>
                            <TextBox x:Name="NoteBox" Style="{StaticResource Field}" Tag="比如：能源大数据相关业务场景（写纪要时 AI 会参考）" Margin="0,6,0,0" TextChanged="Field_Changed"/>

                            <TextBlock Text="英文对应写法（可选）" FontWeight="SemiBold" Margin="0,15,0,0"/>
                            <TextBox x:Name="TranslationBox" Style="{StaticResource Field}" Tag="比如：gateway（纯中文场景留空即可）" Margin="0,6,0,0" TextChanged="Field_Changed"/>

                            <CheckBox x:Name="EnabledBox" Style="{StaticResource SwitchRow}" Content="{local:Loc Key='启用这个词条'}" Margin="0,16,0,0"
                                      Checked="Field_Changed" Unchecked="Field_Changed"/>
                            <CheckBox x:Name="ExactBox" Style="{StaticResource SwitchRow}" Content="{local:Loc Key='只替换列出的写法，不按读音猜'}" Margin="0,10,0,0"
                                      Checked="Field_Changed" Unchecked="Field_Changed"/>
                            <TextBlock Style="{StaticResource Helper}" TextWrapping="Wrap"
                                       Text="{local:Loc Key='默认还会按读音纠正：两个字的词要读音完全相同，三个字以上可以有 zh/z、n/l、前后鼻音这类口音差别。'}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="{local:Loc Key='试一试'}" Style="{StaticResource Overline}"/>
                            <TextBox x:Name="TryBox" Style="{StaticResource Field}" Tag="输入一句识别出来的话，看看会被改成什么" TextChanged="Try_Changed"/>
                            <TextBlock x:Name="TryResult" FontSize="14" TextWrapping="Wrap" Margin="2,10,0,0"/>
                            <TextBlock x:Name="TryFixes" Style="{StaticResource Helper}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
